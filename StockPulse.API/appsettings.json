{
  "DatabasePath": "stockpulse.db",

  "JwtSettings": {
    "Issuer": "StockPulse",
    "Audience": "StockPulseClient",
    "ExpiryHours": "8",
    "Secret": "REPLACE_WITH_A_STRONG_SECRET_MINIMUM_32_CHARACTERS"
  },

  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:5173"
  ],

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
