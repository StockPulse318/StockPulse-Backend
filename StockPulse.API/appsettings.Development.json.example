{
  "DatabasePath": "stockpulse.db",

  "JwtSettings": {
    "Issuer": "StockPulse",
    "Audience": "StockPulseClient",
    "ExpiryHours": "8",
    "Secret": "REPLACE-WITH-A-STRONG-SECRET-MINIMUM-32-CHARACTERS"
  },

  "SeedManager": {
    "Username": "manager",
    "Password": "REPLACE-WITH-A-STRONG-PASSWORD"
  },

  "SeedClerk": {
    "Username": "clerk",
    "Password": "REPLACE-WITH-A-STRONG-PASSWORD"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
