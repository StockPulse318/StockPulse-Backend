# ==============================================================================
# StockPulse Backend Environment Configuration
# ==============================================================================

# Database file path (for hosted deployments with persistent disk storage, e.g. /data/stockpulse.db)
DATABASE_PATH=stockpulse.db

# Environment mode: 'development' or 'production'
ENVIRONMENT=development

# JWT Authentication Configuration
# JWT_SECRET must be at least 32 characters long
JWT_SECRET=replace-this-with-a-secure-random-secret-key-at-least-32-chars
JWT_ISSUER=StockPulse
JWT_AUDIENCE=StockPulseClient
TOKEN_LIFETIME_HOURS=8

# Database Seeding Configuration (used by 'dotnet run -- seed')
# Passwords are NEVER printed or logged by the seeder.
SEED_MANAGER_USERNAME=manager
SEED_CLERK_USERNAME=clerk
SEED_DEFAULT_PASSWORD=StockPulse@2026
